# MoonPay API Key (public/publishable) — used by the React frontend.
# Get yours at https://dashboard.moonpay.com/developers
# Vite only exposes VITE_-prefixed variables to browser code.
VITE_MOONPAY_API_KEY=pk_test_your_api_key_here

# Signing server URL (defaults to http://localhost:5000)
VITE_SIGNING_SERVER_URL=http://localhost:5000

# NOTE: MOONPAY_SECRET_KEY is deliberately NOT listed here.
# It belongs only in server/.env. Keeping a secret-key placeholder in a frontend
# project's env template invites someone to paste the real key next to the public
# one — and one accidental VITE_ prefix would then inline it into the bundle.

# Hosted wallet page that signs the deposit transaction (defaults to http://localhost:3001)
VITE_WALLET_PAGE_URL=http://localhost:3001
