# MoonPay Secret Key (private) — used for HMAC-SHA256 URL signing
# Get yours at https://dashboard.moonpay.com/developers
# NEVER expose this in frontend code
MOONPAY_SECRET_KEY=sk_test_your_secret_key_here

# MoonPay API Key (public/publishable) — REQUIRED.
# The server refuses to sign a widget URL whose apiKey parameter is not this value.
# Without it the endpoint is a signing oracle: anyone who can reach it could mint
# valid signatures for arbitrary wallet addresses and amounts.
MOONPAY_API_KEY=pk_test_your_api_key_here

# Server port (optional, defaults to 5000)
PORT=5000

# Allowed CORS origins (comma-separated).
# Defaults to http://localhost:3000,http://localhost:3001,http://localhost:8080
# Note: CORS is a browser-side control only. It does not stop curl or a
# server-to-server request — the host allowlist and apiKey check below do.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# MoonPay widget hosts this server is willing to sign (comma-separated, exact match).
# Defaults to the four MoonPay buy/sell production and sandbox hosts.
MOONPAY_ALLOWED_HOSTS=buy.moonpay.com,sell.moonpay.com,buy-sandbox.moonpay.com,sell-sandbox.moonpay.com
